          "metricId": "dialogueIntegrated",
          "op": ">",
          "value": -22,
          "severity": "warn"
        },
        {
          "metricId": "dialogueIntegrated",
          "op": "<",
          "value": -26,
          "severity": "warn"
        },
        {
          "metricId": "truePeak",
          "op": ">",
          "value": -2,
          "severity": "fail"
        }
      ]
    }
  ],
  "dependencies": []
