{
  "app": "PLVS",
  "kind": "theme-pack",
  "version": 2,
  "items": [
    {
      "id": "sharesets-mono-dark",
      "kind": "plvs-theme",
      "formatVersion": 1,
      "semanticsVersion": 5,
      "name": "Mono Dark",
      "colorScheme": "dark",
      "core": {
        "workspace": "#050505",
        "surface": "#171717",
        "text": "#f2f2f0",
        "interfaceAccent": "#d2d2cf",
        "primaryData": "#f4f4f1",
        "secondaryData": "#a6a6a2"
      },
      "palettes": {
        "status": {
          "safe": "#777774",
          "warning": "#b3b3af",
          "critical": "#f2f2ef"
        },
        "intensity": {
          "stops": [
            {
              "position": 0,
              "color": "#030303"
            },
            {
              "position": 0.14,
              "color": "#131313"
            },
            {
              "position": 0.3,
              "color": "#292929"
            },
            {
              "position": 0.48,
              "color": "#4a4a49"
            },
            {
              "position": 0.66,
              "color": "#777775"
            },
            {
              "position": 0.84,
              "color": "#b5b5b1"
            },
            {
              "position": 1,
              "color": "#f5f5f1"
            }
          ]
        },
        "frequency": {
          "low": "#747471",
          "mid": "#b5b5b1",
          "high": "#f5f5f1"
        },
        "interface": {
          "success": "#666663",
          "warning": "#9b9b97",
          "danger": "#d7d7d3"
        }
      },
      "overrides": {
        "interface.content.onAccent": {
          "kind": "color",
          "value": "#111111"
        },
        "interface.content.onDanger": {
          "kind": "color",
          "value": "#111111"
        },
        "interface.content.onSuccess": {
          "kind": "color",
          "value": "#ffffff"
        },
        "interface.content.onWarning": {
          "kind": "color",
          "value": "#111111"
        },
        "interface.feedback.danger": {
          "kind": "color",
          "value": "#eeeeea"
        },
        "interface.feedback.success": {
          "kind": "color",
          "value": "#8a8a86"
        },
        "interface.feedback.warning": {
          "kind": "color",
          "value": "#bdbdb8"
        },
        "interface.surface.muted": {
          "kind": "color",
          "value": "#3d3d3b"
        },
        "interface.text.secondary": {
          "kind": "color",
          "value": "#a7a7a3"
        },
        "level.critical": {
          "kind": "color",
          "value": "#f3f3ef"
        },
        "level.safe": {
          "kind": "color",
          "value": "#686866"
        },
        "level.warning": {
          "kind": "color",
          "value": "#adada9"
        },
        "loudness.momentarySnapshot": {
          "kind": "color",
          "value": "#777773"
        },
        "loudness.shortTermSnapshot": {
          "kind": "color",
          "value": "#686865"
        },
        "spectrum.primarySnapshot": {
          "kind": "color",
          "value": "#777773"
        },
        "spectrum.secondarySnapshot": {
          "kind": "color",
          "value": "#686865"
        },
        "stats.criticalValue": {
          "kind": "color",
          "value": "#ffffff"
        },
        "stats.warningValue": {
          "kind": "color",
          "value": "#c3c3be"
        },
        "stereoMap.primarySnapshot": {
          "kind": "color",
          "value": "#777773"
        },
        "stereoMap.secondarySnapshot": {
          "kind": "color",
          "value": "#686865"
        },
        "vectorscope.snapshot": {
          "kind": "color",
          "value": "#6f6f6c"
        },
        "waveform.frequencyHigh": {
          "kind": "color",
          "value": "#f5f5f1"
        },
        "waveform.frequencyLow": {
          "kind": "color",
          "value": "#747471"
        },
        "waveform.frequencyMid": {
          "kind": "color",
          "value": "#b5b5b1"
        },
        "waveform.snapshot": {
          "kind": "color",
          "value": "#6f6f6c"
        }
      }
    }
  ],
  "dependencies": []
}
