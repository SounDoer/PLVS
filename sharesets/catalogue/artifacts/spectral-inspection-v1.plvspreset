{
  "app": "PLVS",
  "kind": "preset-pack",
  "version": 2,
  "items": [
    {
      "id": "spectral-inspection",
      "kind": "plvs-preset",
      "formatVersion": 1,
      "semanticsVersion": 1,
      "name": "Spectral Inspection",
      "workspace": {
        "layout": {
          "type": "split",
          "direction": "vertical",
          "weights": [
            0.56,
            0.44
          ],
          "children": [
            {
              "type": "split",
              "direction": "horizontal",
              "weights": [
                0.65,
                0.35
              ],
              "children": [
                {
                  "type": "panel",
                  "key": "full-spectrum"
                },
                {
                  "type": "panel",
                  "key": "low-end-detail"
                }
              ]
            },
            {
              "type": "split",
              "direction": "horizontal",
              "weights": [
                0.65,
                0.35
              ],
              "children": [
                {
                  "type": "panel",
                  "key": "spectrum-history"
                },
                {
                  "type": "panel",
                  "key": "waveform"
                }
              ]
            }
          ]
        },
        "panels": [
          {
            "key": "full-spectrum",
            "moduleId": "spectrum",
            "title": "Full Spectrum",
            "controls": {
              "channel": {
                "type": "pair",
                "x": 0,
                "y": 1
              },
              "view": "combined",
              "maxMode": "decay",
              "peakLabels": false,
              "grid": true,
              "speedPercent": 25,
              "tiltDbPerOctave": 3,
              "octaveSmoothing": "off",
              "levelRangeDb": {
                "min": -84,
                "max": 0
              }
            },
            "axes": {
              "frequency": {
                "linked": true,
                "minHz": 20,
                "maxHz": 20000
              }
            }
          },
          {
            "key": "low-end-detail",
            "moduleId": "spectrum",
            "title": "Low End Detail",
            "controls": {
              "channel": {
                "type": "pair",
                "x": 0,
                "y": 1
              },
              "view": "combined",
              "maxMode": "hold",
              "peakLabels": true,
              "grid": true,
              "speedPercent": 25,
              "tiltDbPerOctave": 3,
              "octaveSmoothing": "off",
              "levelRangeDb": {
                "min": -72,
                "max": 0
              }
            },
            "axes": {
              "frequency": {
                "linked": false,
                "minHz": 20,
                "maxHz": 250
              }
            }
          },
          {
            "key": "spectrum-history",
            "moduleId": "spectrogram",
            "title": "Spectrum History",
            "controls": {
              "channel": {
                "type": "pair",
                "x": 0,
                "y": 1
              },
              "mode": "heatmap",
              "tiltDbPerOctave": 3,
              "octaveSmoothing": "off",
              "dbFloor": -84
            },
            "axes": {
              "frequency": {
                "linked": true,
                "minHz": 20,
                "maxHz": 20000
              },
              "time": {
                "linked": true,
                "windowSec": 60
              }
            }
          },
          {
            "key": "waveform",
            "moduleId": "waveform",
            "title": "Waveform",
            "controls": {
              "frequencyColor": true,
              "centroid": false
            },
            "axes": {
              "time": {
                "linked": true,
                "windowSec": 60
              }
            }
          }
        ]
      },
      "presentation": {
        "alwaysOnTop": false,
        "focusView": {
          "autoHideControls": false,
          "compactPanels": false,
          "borderless": false
        },
        "panelOpacityPercent": 100,
        "glassEnabled": false
      },
      "dock": {
        "enabled": false
      },
      "loudnessProfile": {
        "dependencyId": null
      }
    }
  ],
  "dependencies": []
}
