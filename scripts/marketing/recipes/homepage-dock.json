{
  "version": 1,
  "id": "homepage-dock",
  "audio": {
    "path": "assets/marketing/audio/discovery-hero.wav",
    "provenancePath": "assets/marketing/audio/discovery-hero.source.json",
    "sha256": "8cff42b901afc810d101298b0424b3bbde472f4f6551bcc8732de0d57984d988"
  },
  "environment": {
    "platform": "win32",
    "width": 2560,
    "height": 225,
    "windowDpi": 120,
    "textScalePercent": 100
  },
  "startup": {
    "themeId": "plvs-dark",
    "dismissSurfaces": [{ "kind": "update", "phase": "preferences", "action": "cancel" }],
    "surfaceTimeoutMs": 15000
  },
  "capture": {
    "source": "live",
    "inputLabel": "CABLE Output (VB-Audio Virtual Cable)",
    "renderEndpointName": "CABLE Input",
    "historySeconds": 65,
    "dock": { "edge": "top", "reserveSpace": false, "height": 180 }
  },
  "strips": [
    {
      "name": "dock-default",
      "layout": "current-first-run-default",
      "transport": "live-edge"
    },
    {
      "name": "dock-custom",
      "transport": "snapshot",
      "snapshotOffsetSec": 0,
      "layout": {
        "panels": [
          {
            "panelId": "level",
            "customTitle": "Peak",
            "width": 330,
            "controls": { "orientation": "left-to-right", "mode": "peak", "tpMaxMarker": true }
          },
          {
            "key": "rms",
            "moduleId": "levelMeter",
            "customTitle": "RMS",
            "width": 330,
            "controls": { "orientation": "left-to-right", "mode": "rms" }
          },
          { "panelId": "loudness", "width": 300, "controls": { "orientation": "top-to-bottom" } },
          { "panelId": "spectrum", "width": 800 },
          { "panelId": "correlation", "width": 240 }
        ]
      }
    }
  ],
  "publication": {
    "dock-default": {
      "webp": "website/assets/landing-dock.webp",
      "png": "website/assets/raw/landing-dock.png",
      "metadata": "website/assets/raw/landing-dock.json"
    },
    "dock-custom": {
      "webp": "website/assets/landing-dock-custom.webp",
      "png": "website/assets/raw/landing-dock-custom.png",
      "metadata": "website/assets/raw/landing-dock-custom.json"
    },
    "html": "website/index.html"
  },
  "review": {
    "url": "http://127.0.0.1:4173/",
    "viewports": [1440, 820, 390],
    "scrollViewport": 390
  }
}
