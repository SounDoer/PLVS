<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Update acceptance runner only (ADR 0038). Never shipped in a PLVS package. -->
<policyconfig>
  <vendor>PLVS</vendor>
  <vendor_url>https://plvs.soundoer.com/</vendor_url>
  <action id="com.soundoer.plvs.update-acceptance">
    <description>Install or restore the PLVS package for update acceptance</description>
    <message>Authentication is required to change the PLVS test package</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/plvs-update-acceptance-package</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
