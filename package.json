{
  "name": "plvs",
  "description": "PLVS — real-time audio metering desktop app (Peak / Loudness / Vectorscope / Spectrum)",
  "private": true,
  "version": "0.14.4",
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:history-perf": "vite --open \"/?historyPerf=240m\"",
    "prepare": "simple-git-hooks",
    "theme:generate": "node scripts/generate-theme-fallbacks.mjs",
    "agent:generate": "node scripts/generate-agent-discovery.mjs",
    "prebuild": "npm run theme:generate && npm run agent:generate",
    "build": "vite build",
    "benchmark:history": "node scripts/history-perf-benchmark.mjs",
    "benchmark:history:full": "node scripts/history-perf-benchmark.mjs --full-visual",
    "benchmark:history-chunks": "node scripts/history-chunk-size-benchmark.mjs",
    "benchmark:spectrum-render": "node scripts/spectrum-render-benchmark.mjs",
    "benchmark:spectrogram-render": "node scripts/spectrogram-render-benchmark.mjs",
    "benchmark:waveform-render": "node scripts/waveform-render-benchmark.mjs",
    "benchmark:vectorscope-render": "node scripts/vectorscope-render-benchmark.mjs",
    "benchmark:loudness-history": "node scripts/loudness-history-benchmark.mjs",
    "benchmark:vectorscope-rust": "cargo bench --manifest-path src-tauri/Cargo.toml --bench vectorscope",
    "benchmark:stereo-map-rust": "cargo bench --manifest-path src-tauri/Cargo.toml --bench stereo_map",
    "benchmark:stereo-map-render": "node scripts/stereo-map-render-benchmark.mjs",
    "benchmark:frame-wire": "node scripts/frame-wire-benchmark.mjs",
    "experiment:stereo-map-energy-codec": "node scripts/stereo-map-energy-codec-experiment.mjs",
    "experiment:stereo-map-opacity-codec": "node scripts/stereo-map-opacity-codec-experiment.mjs",
    "diagnose:surface-fallback": "node scripts/diagnose-surface-fallback.mjs",
    "profile:webview": "node scripts/webview-cpu-profile.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,json}\"",
    "lint": "eslint src",
    "version:check": "node scripts/verify-versions.mjs",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:check": "npm run rust:fmt && npm run rust:clippy && npm run rust:test",
    "check": "npm run version:check && npm run format:check && npm run lint && npm test && npm run build && npm run rust:check",
    "release:preflight": "node scripts/run-release-gate.mjs",
    "smoke:file-analysis": "npm run ffmpeg:fetch && node scripts/smoke-file-analysis.mjs",
    "smoke:capture": "node scripts/smoke-capture.mjs",
    "soak:capture": "node scripts/soak-capture.mjs",
    "verify:ui-backpressure": "node scripts/verify-ui-frame-backpressure.mjs",
    "soak:desktop": "node scripts/soak-desktop.mjs",
    "tauri": "tauri",
    "ffmpeg:fetch": "node scripts/fetch-ffmpeg-sidecar.mjs",
    "desktop": "npm run ffmpeg:fetch && tauri dev",
    "desktop:build": "npm run ffmpeg:fetch && tauri build --config src-tauri/tauri.no-updater.conf.json",
    "desktop:dev-nsis": "npm run ffmpeg:fetch && tauri build --bundles nsis --config src-tauri/tauri.no-updater.conf.json",
    "desktop:release-nsis": "npm run ffmpeg:fetch && tauri build --bundles nsis",
    "desktop:release-dmg": "npm run ffmpeg:fetch && tauri build --bundles dmg,app",
    "desktop:verify-windows-installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-installer.ps1",
    "desktop:verify-macos-dmg": "bash scripts/verify-macos-dmg.sh"
  },
  "simple-git-hooks": {
    "pre-commit": "cargo fmt --manifest-path src-tauri/Cargo.toml --all && npx lint-staged && { git diff --cached --name-only | grep -q src-tauri/Cargo.toml && (cd src-tauri && cargo update --workspace && git add Cargo.lock) || true; }"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,css,json}": "prettier --write"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.25.0",
    "plvs": "file:../../..",
    "react": "^19.2.7",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.11.3",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.5",
    "sharp": "^0.35.1",
    "simple-git-hooks": "^2.13.0",
    "tailwindcss": "^4.2.4",
    "vite": "^8.1.5",
    "vitest": "^4.1.8"
  }
}
